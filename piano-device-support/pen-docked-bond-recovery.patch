+def hid_has_empty_id(address):
+    identities = set()
+    for uevent in Path('/sys/bus/hid/devices').glob('0005:*/uevent'):
+        try:
+            fields = dict(line.split('=', 1) for line in uevent.read_text().splitlines()
+                          if '=' in line)
+        except OSError:
+            continue
+        if fields.get('HID_UNIQ', '').upper() == address:
+            identities.add(fields.get('HID_ID'))
+    return identities == {'0005:00000000:00000000'}
+
