#!/bin/sh
# SPDX-License-Identifier: MIT
# Rebuild this slot's boot image set after a kernel install.
# Nothing here assumes a release naming scheme: every candidate is taken from
# /boot/initrd.img-* and the newest one wins.
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

release=${1:-}
[ -n "$release" ] || exit 0
[ -e /etc/piano/layout.json ] || exit 0
[ -e "/boot/initrd.img-$release" ] || exit 0

latest=
for initrd in /boot/initrd.img-*; do
    [ -e "$initrd" ] || continue
    candidate=${initrd##*/initrd.img-}
    if [ -z "$latest" ] ||
       [ "$(printf '%s\n%s\n' "$latest" "$candidate" | sort -V | tail -n1)" = "$candidate" ]; then
        latest=$candidate
    fi
done

if [ "$release" != "$latest" ]; then
    echo "zz-piano-boot: $release is older than $latest; boot image set unchanged" >&2
    exit 0
fi

exec /usr/sbin/piano-boot-update "$release"
