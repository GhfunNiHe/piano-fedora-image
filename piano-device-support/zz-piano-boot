#!/bin/sh
# SPDX-License-Identifier: MIT
# Rebuild this slot's boot image set after a kernel install.
# Fedora's dracut writes /boot/initramfs-*.img, while Debian-style images use
# /boot/initrd.img-*. Accept both names and let the newest initramfs win.
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

release=${1:-}
[ -n "$release" ] || exit 0
[ -e /etc/piano/layout.json ] || exit 0
[ -e "/boot/initrd.img-$release" ] ||
    [ -e "/boot/initramfs-$release.img" ] || exit 0

latest=
latest_initrd=
for initrd in /boot/initrd.img-* /boot/initramfs-*.img; do
    [ -e "$initrd" ] || continue
    case "$initrd" in
        /boot/initrd.img-*)
            candidate=${initrd##*/initrd.img-}
            ;;
        /boot/initramfs-*.img)
            candidate=${initrd##*/initramfs-}
            candidate=${candidate%.img}
            ;;
        *)
            continue
            ;;
    esac
    if [ -z "$latest_initrd" ] || [ "$initrd" -nt "$latest_initrd" ]; then
        latest=$candidate
        latest_initrd=$initrd
    fi
done

if [ "$release" != "$latest" ]; then
    echo "zz-piano-boot: $release is not the newest installed kernel ($latest); boot image set unchanged" >&2
    exit 0
fi

exec /usr/sbin/piano-boot-update "$release"
