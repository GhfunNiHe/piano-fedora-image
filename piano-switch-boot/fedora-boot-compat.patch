+def is_piano_release(release):
+    return re.fullmatch(r'[0-9][A-Za-z0-9.+-]*-(?:piano[0-9]+|sm8750-g[0-9a-f]+)', release) is not None
+
+
+def initrd_path(root, release):
+    for name in (f'boot/initramfs-{release}.img', f'boot/initrd.img-{release}'):
+        path = root / name
+        if path.is_file():
+            return path
+    return None
+
+
+def newest_piano_release(run, root=Path('/')):
+    candidates = []
+    for kernel in (root / 'boot').glob('vmlinuz-*'):
+        release = kernel.name.removeprefix('vmlinuz-')
+        initrd = initrd_path(root, release)
+        if (is_piano_release(release) and initrd and
+                (root / f'usr/lib/linux-image-{release}/piano-boot.dtb').is_file()):
+            candidates.append((initrd.stat().st_mtime_ns, release))
+    return max(candidates)[1] if candidates else None
 
 
