+[ -e "/boot/initramfs-$1.img" ] || [ -e "/boot/initrd.img-$1" ] || exit 0
+latest=
+latest_initrd=
+for initrd in /boot/initramfs-*.img /boot/initrd.img-*; do
+    [ -e "$initrd" ] || continue
+    case "$initrd" in
+        /boot/initramfs-*.img)
+            candidate=${initrd##*/initramfs-}
+            candidate=${candidate%.img}
+            ;;
+        /boot/initrd.img-*)
+            candidate=${initrd##*/initrd.img-}
+            ;;
+    esac
+    case "$candidate" in *-piano[0-9]*|*-sm8750-g*) ;; *) continue;; esac
+    [ -e "/boot/vmlinuz-$candidate" ] || continue
+    [ -e "/usr/lib/linux-image-$candidate/piano-boot.dtb" ] || continue
+    if [ -z "$latest_initrd" ] || [ "$initrd" -nt "$latest_initrd" ]; then
+        latest=$candidate
+        latest_initrd=$initrd
+    fi
+done
