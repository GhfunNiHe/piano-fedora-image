Subject: power: supply: Xiaomi MCA: retry MiPPS discovery in DFP

Source-commit: b5100d5f2e0bb80e1191d521a48596674608eb3d

diff --git a/drivers/power/supply/xiaomi_mca.c b/drivers/power/supply/xiaomi_mca.c
index 3894242..46399e0 100644
--- a/drivers/power/supply/xiaomi_mca.c
+++ b/drivers/power/supply/xiaomi_mca.c
@@ -219,6 +219,7 @@ struct xiaomi_mca_pdo {
 #define MCA_VDM_LEN		16
 #define MCA_DATA_ROLE_UFP	1
 #define MCA_DATA_ROLE_DFP	2
+#define MCA_XIAOMI_SVID		0x2717
 
 /*
  * Charger types as named by the stock sysfs "real_type" table; 13 and 16
@@ -796,6 +797,7 @@ struct xiaomi_mca {
 	struct notifier_block psy_nb;
 	bool auth_cleanup;	/* verify_process clear still needs confirmation */
 	bool mipps_attempted;	/* throttle repeated exchanges on the current cable */
+	bool mipps_dfp_attempted;
 	u32 service_generation;
 	u32 policy_generation;
 	bool policy_active;
@@ -1256,6 +1258,9 @@ static bool xiaomi_mca_write_allowed(u32 prop, const void *data, size_t len)
 	case MCA_PROP_PPS_SELECT:
 		return hv_charge && len == sizeof(u32) &&
 		       xiaomi_mca_pps_word_ok(val);
+	case MCA_PROP_DATA_ROLE:
+		return mipps_auth && len == sizeof(u32) &&
+		       (val == MCA_DATA_ROLE_UFP || val == MCA_DATA_ROLE_DFP);
 	case MCA_PROP_VDM_VERSION:
 	case MCA_PROP_VDM_VOLTAGE:
 	case MCA_PROP_VDM_TEMP:
@@ -1630,6 +1635,57 @@ static int xiaomi_mca_vdm(struct xiaomi_mca *mca, unsigned int generation,
 	return -ETIMEDOUT;
 }
 
+static int xiaomi_mca_set_role(struct xiaomi_mca *mca, u32 generation, u32 role)
+{
+	unsigned long deadline;
+	int ret;
+
+	if (!xiaomi_mca_auth_current(mca, generation))
+		return -ENODEV;
+	ret = xiaomi_mca_write_u32(mca, MCA_PROP_DATA_ROLE, role);
+	if (ret)
+		return ret;
+
+	deadline = jiffies + msecs_to_jiffies(1000);
+	do {
+		if (!xiaomi_mca_auth_current(mca, generation))
+			return -ENODEV;
+		if (xiaomi_mca_read_u32(mca, MCA_PROP_DATA_ROLE) == role)
+			return 0;
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * Some Xiaomi USB-A sources only expose their private VDM interface after the
+ * data role has moved to DFP. Keep this fallback bounded and require the
+ * Xiaomi SVID before continuing; failed probes restore the original UFP role.
+ */
+static int xiaomi_mca_mipps_retry_dfp(struct xiaomi_mca *mca,
+				      unsigned int generation)
+{
+	unsigned long deadline;
+	int ret;
+
+	ret = xiaomi_mca_set_role(mca, generation, MCA_DATA_ROLE_DFP);
+	if (ret)
+		return ret;
+
+	deadline = jiffies + msecs_to_jiffies(2000);
+	do {
+		if (!xiaomi_mca_auth_current(mca, generation))
+			return -ENODEV;
+		if (xiaomi_mca_read_u32(mca, MCA_PROP_ADAPTER_SVID) ==
+		    MCA_XIAOMI_SVID)
+			return 0;
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	return -ENODEV;
+}
+
 static bool xiaomi_mca_mipps_digest(struct xiaomi_mca *mca,
 				  const struct piano_mipps_key *key,
 				  u8 message[20], const u8 response[MCA_VDM_LEN],
@@ -1682,7 +1738,7 @@ static void xiaomi_mca_mipps_authenticate(struct xiaomi_mca *mca)
 	unsigned int generation = READ_ONCE(mca->service_generation);
 	u32 attachment = READ_ONCE(mca->attach_generation);
 	u32 adapter_id;
-	bool discovered = false, capable = false;
+	bool discovered = false, capable = false, tried_dfp = false;
 	int i, ret;
 
 	if (!mipps_auth || mca->auth_lost || mca->mipps_attempted || xiaomi_mca_authenticated(mca) ||
@@ -1707,8 +1763,18 @@ static void xiaomi_mca_mipps_authenticate(struct xiaomi_mca *mca)
 	if (ret)
 		goto finish;
 
-	/* A Xiaomi VDM query works as UFP too. Never swap PC/hub data roles. */
+	/* Try UFP first. Policy retries must not repeat a DFP swap. */
 	ret = xiaomi_mca_vdm(mca, generation, 1, NULL, 0);
+	if (ret == -ETIMEDOUT && !mca->mipps_dfp_attempted &&
+	    xiaomi_mca_read_u32(mca, MCA_PROP_DATA_ROLE) == MCA_DATA_ROLE_UFP) {
+		dev_info(mca->dev,
+			 "MiPPS VDM query timed out as UFP; retrying as DFP\n");
+		mca->mipps_dfp_attempted = true;
+		tried_dfp = true;
+		ret = xiaomi_mca_mipps_retry_dfp(mca, generation);
+		if (!ret)
+			ret = xiaomi_mca_vdm(mca, generation, 1, NULL, 0);
+	}
 	if (ret)
 		goto finish;
 	ret = xiaomi_mca_read_blob(mca, MCA_PROP_VDM_VERSION, &version, sizeof(version));
@@ -1771,6 +1837,8 @@ finish:
 			if (xiaomi_mca_auth_current(mca, generation))
 				xiaomi_mca_vdm(mca, generation, 7, NULL, 0);
 		}
+		if (ret && tried_dfp)
+			xiaomi_mca_set_role(mca, generation, MCA_DATA_ROLE_UFP);
 		/* An unconfirmed clear blocks voltage negotiation until it succeeds. */
 		mca->auth_cleanup = true;
 		xiaomi_mca_clear_auth(mca);
@@ -5349,6 +5417,7 @@ static void xiaomi_mca_policy_poll(struct xiaomi_mca *mca, u32 *sampled_type)
 		mca->term_count = 0;
 		mca->auth_ok = false;
 		mca->mipps_attempted = false;
+		mca->mipps_dfp_attempted = false;
 		mca->cp = MCA_CP_OFF;
 		mca->hv = MCA_HV_OFF;
 		mca->aicl_cap_ma = 0;
diff --git a/drivers/power/supply/xiaomi_mca_test.c b/drivers/power/supply/xiaomi_mca_test.c
index 9c00e15..1e6d773 100644
