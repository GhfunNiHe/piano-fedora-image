+static void xiaomi_mca_sync_usb_role(struct xiaomi_mca *mca,
+				     enum usb_role role)
+{
+	int ret;
+
+	if (!mca->usb_role_sw)
+		return;
+
+	ret = usb_role_switch_set_role(mca->usb_role_sw, role);
+	if (ret)
+		dev_warn(mca->dev, "failed to set USB %s role: %d\n",
+			 role == USB_ROLE_HOST ? "host" : "device", ret);
+}
+
+static int xiaomi_mca_set_role(struct xiaomi_mca *mca, u32 generation, u32 role)
+{
+	enum usb_role usb_role = role == MCA_DATA_ROLE_DFP ?
+				 USB_ROLE_HOST : USB_ROLE_DEVICE;
+	unsigned long deadline;
+	int ret;
+
+	if (!xiaomi_mca_auth_current(mca, generation))
+		return -ENODEV;
+	ret = xiaomi_mca_write_u32(mca, MCA_PROP_DATA_ROLE, role);
+	if (ret)
+		return ret;
+
+	deadline = jiffies + msecs_to_jiffies(1000);
+	do {
+		if (!xiaomi_mca_auth_current(mca, generation))
+			return -ENODEV;
+		if (xiaomi_mca_read_u32(mca, MCA_PROP_DATA_ROLE) == role) {
+			if (!xiaomi_mca_auth_current(mca, generation))
+				return -ENODEV;
+			xiaomi_mca_sync_usb_role(mca, usb_role);
+			return 0;
+		}
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * Some Xiaomi USB-A sources only expose their private VDM interface after the
+ * data role has moved to DFP. Keep this fallback bounded and require the
+ * Xiaomi SVID before continuing; failed probes restore the original UFP role.
+ */
+static int xiaomi_mca_mipps_retry_dfp(struct xiaomi_mca *mca,
+				      unsigned int generation)
+{
+	unsigned long deadline;
+	int ret;
+
+	ret = xiaomi_mca_set_role(mca, generation, MCA_DATA_ROLE_DFP);
+	if (ret)
+		return ret;
+
+	deadline = jiffies + msecs_to_jiffies(2000);
+	do {
+		if (!xiaomi_mca_auth_current(mca, generation))
+			return -ENODEV;
+		if (xiaomi_mca_read_u32(mca, MCA_PROP_ADAPTER_SVID) ==
+		    MCA_XIAOMI_SVID)
+			return 0;
+		msleep(20);
+	} while (time_before(jiffies, deadline));
+
+	return -ENODEV;
+}
