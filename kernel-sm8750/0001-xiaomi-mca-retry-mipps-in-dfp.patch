 		mca->cp = MCA_CP_OFF;
@@ -4311,6 +4400,37 @@ static int xiaomi_mca_battery_ext_register(struct xiaomi_mca *mca)
 	return 0;
 }
 
+static void xiaomi_mca_usb_role_switch_put(void *data)
+{
+	usb_role_switch_put(data);
+}
+
+static int xiaomi_mca_get_usb_role_switch(struct xiaomi_mca *mca)
+{
+	struct device *dev = mca->dev;
+
+	if (!mca->piano_otg)
+		return 0;
+
+	device_for_each_child_node_scoped(dev, connector) {
+		if (!fwnode_device_is_compatible(connector, "usb-c-connector"))
+			continue;
+
+		mca->usb_role_sw = fwnode_usb_role_switch_get(connector);
+		if (IS_ERR(mca->usb_role_sw))
+			return dev_err_probe(dev, PTR_ERR(mca->usb_role_sw),
+					     "failed to get USB role switch\n");
+		if (!mca->usb_role_sw)
+			return 0;
+
+		return devm_add_action_or_reset(dev,
+					       xiaomi_mca_usb_role_switch_put,
+					       mca->usb_role_sw);
+	}
+
+	return 0;
+}
+
 static int xiaomi_mca_probe(struct auxiliary_device *adev,
 			    const struct auxiliary_device_id *id)
 {
@@ -4327,6 +4447,9 @@ static int xiaomi_mca_probe(struct auxiliary_device *adev,
 	mca->charge_end = 100;
 	mca->piano_otg = of_device_is_compatible(dev->of_node, "xiaomi,piano-pmic-glink");
 	dev_set_drvdata(dev, mca);
+	ret = xiaomi_mca_get_usb_role_switch(mca);
+	if (ret)
+		return ret;
 	init_completion(&mca->ack);
 	spin_lock_init(&mca->rx_lock);
 	ret = devm_mutex_init(dev, &mca->lock);
