 	int ucsi_online, ucsi_type, ucsi_status, ucsi_charge_type;
 	__le32 auth_response[4];
 	u32 vdm_order[16], vdm_count, seed_index;
 	bool simulate_auth, bad_digest, fail_verify, fail_clear;
