 				  u8 message[20], const u8 response[MCA_VDM_LEN],
@@ -1373,7 +1446,7 @@ static void xiaomi_mca_mipps_authenticate(struct xiaomi_mca *mca)
 	unsigned int generation = READ_ONCE(mca->service_generation);
 	u32 attachment = READ_ONCE(mca->attach_generation);
 	u32 adapter_id;
-	bool discovered = false, capable = false;
+	bool discovered = false, capable = false, tried_dfp = false;
 	int i, ret;
 
 	if (!mipps_auth || mca->mipps_attempted || xiaomi_mca_authenticated(mca) ||
@@ -1397,8 +1470,17 @@ static void xiaomi_mca_mipps_authenticate(struct xiaomi_mca *mca)
 	if (ret)
 		goto finish;
 
-	/* A Xiaomi VDM query works as UFP too. Never swap PC/hub data roles. */
+	/* Try UFP first; only Xiaomi sources with a failed query get DFP retry. */
 	ret = xiaomi_mca_vdm(mca, generation, 1, NULL, 0);
+	if (ret == -ETIMEDOUT &&
+	    xiaomi_mca_read_u32(mca, MCA_PROP_DATA_ROLE) == MCA_DATA_ROLE_UFP) {
+		dev_info(mca->dev,
+			 "MiPPS VDM query timed out as UFP; retrying as DFP\n");
+		tried_dfp = true;
+		ret = xiaomi_mca_mipps_retry_dfp(mca, generation);
+		if (!ret)
+			ret = xiaomi_mca_vdm(mca, generation, 1, NULL, 0);
+	}
 	if (ret)
 		goto finish;
 	ret = xiaomi_mca_read_blob(mca, MCA_PROP_VDM_VERSION, &version, sizeof(version));
@@ -1458,6 +1540,8 @@ static void xiaomi_mca_mipps_authenticate(struct xiaomi_mca *mca)
 	}
 finish:
 	if (generation == READ_ONCE(mca->service_generation)) {
+		if (ret && tried_dfp)
+			xiaomi_mca_set_role(mca, generation, MCA_DATA_ROLE_UFP);
 		if (ret && discovered) {
 			xiaomi_mca_write_u32(mca, MCA_PROP_PD_VERIFIED, 0);
 			if (xiaomi_mca_auth_current(mca, generation))
@@ -3212,6 +3296,8 @@ static void xiaomi_mca_process_notifications(struct xiaomi_mca *mca)
 			mca->otg_active = true;
 			ret = xiaomi_mca_otg_cp(mca, record.data[0] ?
 					SC8541_OTG_REVERSE_ON : SC8541_OTG_REVERSE_OFF);
+			if (!ret && record.data[0])
+				xiaomi_mca_sync_usb_role(mca, USB_ROLE_HOST);
 			if (!ret && !record.data[0])
 				mca->otg_active = false;
 			break;
@@ -3223,6 +3309,8 @@ static void xiaomi_mca_process_notifications(struct xiaomi_mca *mca)
 			 */
 			ret = xiaomi_mca_read_blob(mca, MCA_PROP_OTG_PLUGIN,
 						  &plugin, sizeof(plugin));
+			if (!ret && plugin)
+				xiaomi_mca_sync_usb_role(mca, USB_ROLE_HOST);
 			if (!ret && !plugin)
 				ret = xiaomi_mca_otg_cp(mca, SC8541_OTG_DETACH);
 			break;
@@ -3338,6 +3426,7 @@ static void xiaomi_mca_policy_poll(struct xiaomi_mca *mca)
 	if (attachment != mca->policy_attach_generation) {
 		if (xiaomi_mca_cp_stop(mca, "physical disconnect"))
