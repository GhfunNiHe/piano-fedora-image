 				  const struct piano_mipps_key *key,
 				  u8 message[20], const u8 response[MCA_VDM_LEN],
@@ -1682,7 +1760,7 @@ static void xiaomi_mca_mipps_authenticate(struct xiaomi_mca *mca)
 	unsigned int generation = READ_ONCE(mca->service_generation);
 	u32 attachment = READ_ONCE(mca->attach_generation);
 	u32 adapter_id;
-	bool discovered = false, capable = false;
+	bool discovered = false, capable = false, tried_dfp = false;
 	int i, ret;
 
 	if (!mipps_auth || mca->auth_lost || mca->mipps_attempted || xiaomi_mca_authenticated(mca) ||
@@ -1707,8 +1785,18 @@ static void xiaomi_mca_mipps_authenticate(struct xiaomi_mca *mca)
 	if (ret)
 		goto finish;
 
-	/* A Xiaomi VDM query works as UFP too. Never swap PC/hub data roles. */
+	/* Try UFP first. Policy retries must not repeat a DFP swap. */
 	ret = xiaomi_mca_vdm(mca, generation, 1, NULL, 0);
+	if (ret == -ETIMEDOUT && !mca->mipps_dfp_attempted &&
+	    xiaomi_mca_read_u32(mca, MCA_PROP_DATA_ROLE) == MCA_DATA_ROLE_UFP) {
+		dev_info(mca->dev,
+			 "MiPPS VDM query timed out as UFP; retrying as DFP\n");
+		mca->mipps_dfp_attempted = true;
+		tried_dfp = true;
+		ret = xiaomi_mca_mipps_retry_dfp(mca, generation);
+		if (!ret)
+			ret = xiaomi_mca_vdm(mca, generation, 1, NULL, 0);
+	}
 	if (ret)
 		goto finish;
 	ret = xiaomi_mca_read_blob(mca, MCA_PROP_VDM_VERSION, &version, sizeof(version));
@@ -1771,6 +1859,8 @@ static void xiaomi_mca_mipps_authenticate(struct xiaomi_mca *mca)
 			if (xiaomi_mca_auth_current(mca, generation))
 				xiaomi_mca_vdm(mca, generation, 7, NULL, 0);
 		}
+		if (ret && tried_dfp)
+			xiaomi_mca_set_role(mca, generation, MCA_DATA_ROLE_UFP);
 		/* An unconfirmed clear blocks voltage negotiation until it succeeds. */
 		mca->auth_cleanup = true;
 		xiaomi_mca_clear_auth(mca);
@@ -5194,6 +5284,8 @@ static void xiaomi_mca_process_notifications(struct xiaomi_mca *mca)
 			mca->otg_active = true;
 			ret = xiaomi_mca_otg_cp(mca, record.data[0] ?
 					SC8541_OTG_REVERSE_ON : SC8541_OTG_REVERSE_OFF);
+			if (!ret && record.data[0])
+				xiaomi_mca_sync_usb_role(mca, USB_ROLE_HOST);
 			if (!ret && !record.data[0])
 				mca->otg_active = false;
 			break;
@@ -5209,6 +5301,8 @@ static void xiaomi_mca_process_notifications(struct xiaomi_mca *mca)
 			 */
 			ret = xiaomi_mca_read_blob(mca, MCA_PROP_OTG_PLUGIN,
 						  &plugin, sizeof(plugin));
+			if (!ret && plugin)
+				xiaomi_mca_sync_usb_role(mca, USB_ROLE_HOST);
 			if (!ret && !plugin)
 				ret = xiaomi_mca_otg_cp(mca, SC8541_OTG_DETACH);
 			break;
@@ -5342,6 +5436,7 @@ static void xiaomi_mca_policy_poll(struct xiaomi_mca *mca, u32 *sampled_type)
 	if (attachment != mca->policy_attach_generation) {
 		if (xiaomi_mca_cp_stop(mca, "physical disconnect"))
 			return;
+		xiaomi_mca_sync_usb_role(mca, USB_ROLE_DEVICE);
 		mca->ffc_active = false;
 		mca->ffc_done = false;
 		mca->charging_done = false;
@@ -5349,6 +5444,7 @@ static void xiaomi_mca_policy_poll(struct xiaomi_mca *mca, u32 *sampled_type)
 		mca->term_count = 0;
 		mca->auth_ok = false;
 		mca->mipps_attempted = false;
+		mca->mipps_dfp_attempted = false;
 		mca->cp = MCA_CP_OFF;
 		mca->hv = MCA_HV_OFF;
 		mca->aicl_cap_ma = 0;
@@ -6745,6 +6841,37 @@ static const struct file_operations xiaomi_mca_experiment_fops = {
 };
 #endif
 
+static void xiaomi_mca_usb_role_switch_put(void *data)
+{
+	usb_role_switch_put(data);
+}
+
+static int xiaomi_mca_get_usb_role_switch(struct xiaomi_mca *mca)
+{
+	struct device *dev = mca->dev;
+
+	if (!mca->piano_otg)
+		return 0;
+
+	device_for_each_child_node_scoped(dev, connector) {
+		if (!fwnode_device_is_compatible(connector, "usb-c-connector"))
+			continue;
+
+		mca->usb_role_sw = fwnode_usb_role_switch_get(connector);
+		if (IS_ERR(mca->usb_role_sw))
+			return dev_err_probe(dev, PTR_ERR(mca->usb_role_sw),
+					     "failed to get USB role switch\n");
+		if (!mca->usb_role_sw)
+			return 0;
+
+		return devm_add_action_or_reset(dev,
+					       xiaomi_mca_usb_role_switch_put,
+					       mca->usb_role_sw);
+	}
+
+	return 0;
+}
+
 static int xiaomi_mca_probe(struct auxiliary_device *adev,
 			    const struct auxiliary_device_id *id)
 {
@@ -6766,6 +6893,9 @@ static int xiaomi_mca_probe(struct auxiliary_device *adev,
 
 	mca->charge_end = 100;
 	dev_set_drvdata(dev, mca);
+	ret = xiaomi_mca_get_usb_role_switch(mca);
+	if (ret)
+		return ret;
 	init_completion(&mca->ack);
 	spin_lock_init(&mca->rx_lock);
 	ret = devm_mutex_init(dev, &mca->transfer_lock);
