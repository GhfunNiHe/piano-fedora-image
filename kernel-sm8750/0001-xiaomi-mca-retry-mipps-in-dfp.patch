@@ -636,6 +638,15 @@ static int mca_policy_xfer(struct xiaomi_mca *mca, u32 op, u32 prop,
 		}
 		if (prop == MCA_PROP_PD_VERIFIED)
 			f->verified = get_unaligned_le32(data);
+		if (prop == MCA_PROP_DATA_ROLE) {
+			f->data_role = get_unaligned_le32(data);
+			if (f->data_role == MCA_DATA_ROLE_DFP)
+				f->svid = MCA_XIAOMI_SVID;
+		}
+		if (f->simulate_auth && f->fail_ufp_vdm &&
+		    prop == MCA_PROP_VDM_VERSION &&
+		    f->data_role == MCA_DATA_ROLE_UFP)
+			return -ETIMEDOUT;
 		if (f->simulate_auth && prop >= MCA_PROP_VDM_BASE &&
 		    prop <= MCA_PROP_VDM_REVERSE) {
 			u8 bytes[MCA_VDM_LEN];
@@ -769,6 +780,9 @@ static int mca_policy_xfer(struct xiaomi_mca *mca, u32 op, u32 prop,
 	case MCA_PROP_VDM_VERSION:
 		value = f->vdm_version;
 		break;
+	case MCA_PROP_DATA_ROLE:
+		value = f->data_role;
+		break;
 	case MCA_PROP_UVDM_STATE:
 		value = f->vdm_state;
 		break;
@@ -827,6 +841,7 @@ static struct mca_policy_fixture *mca_policy_fixture(struct kunit *test)
 	f->fcc = 500;
 	f->tbat = 25;
 	f->mca.real_type = f->type;
+	f->data_role = MCA_DATA_ROLE_UFP;
 	f->mca.vbus_uv = f->vbus;
 	f->mca.cp_ma = 6000;
 	kunit_activate_static_stub(test, xiaomi_mca_transfer_data, mca_policy_xfer);
@@ -1077,6 +1092,12 @@ static void xiaomi_mca_test_auth_read_only(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dev_attr_data_role.attr.mode, 0444);
 	KUNIT_EXPECT_FALSE(test, xiaomi_mca_write_allowed(MCA_PROP_DATA_ROLE, &val, 4));
 	KUNIT_EXPECT_FALSE(test, xiaomi_mca_write_allowed(MCA_PROP_VDM_REVERSE, &val, 4));
+	val = cpu_to_le32(MCA_DATA_ROLE_DFP);
+	mipps_auth = true;
+	KUNIT_EXPECT_TRUE(test, xiaomi_mca_write_allowed(MCA_PROP_DATA_ROLE, &val, 4));
+	val = cpu_to_le32(3);
+	KUNIT_EXPECT_FALSE(test, xiaomi_mca_write_allowed(MCA_PROP_DATA_ROLE, &val, 4));
+	mipps_auth = false;
 }
 
 static void xiaomi_mca_test_temperature_follow(struct kunit *test)
@@ -3404,6 +3425,41 @@ static void xiaomi_mca_test_mipps_exchange(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, f->mca.policy_attach_generation, f->mca.attach_generation);
 }
 
+static void xiaomi_mca_test_mipps_dfp_fallback(struct kunit *test)
+{
+	struct mca_policy_fixture *f = mca_auth_fixture(test);
+
+	f->fail_ufp_vdm = true;
+	guard(mutex)(&f->mca.lock);
+	xiaomi_mca_mipps_authenticate(&f->mca);
+	KUNIT_EXPECT_EQ(test, f->data_role, MCA_DATA_ROLE_DFP);
+	KUNIT_EXPECT_TRUE(test, xiaomi_mca_authenticated(&f->mca));
+	KUNIT_EXPECT_EQ(test, f->verified, 1);
+	KUNIT_EXPECT_EQ(test, f->verify, 0);
+	KUNIT_EXPECT_EQ(test, f->vdm_count, 7);
+}
+
+static void xiaomi_mca_test_mipps_dfp_failure_once(struct kunit *test)
+{
+	struct mca_policy_fixture *f = mca_auth_fixture(test);
+
+	f->fail_ufp_vdm = true;
+	f->vdm_version = 0;
+	guard(mutex)(&f->mca.lock);
+	xiaomi_mca_mipps_authenticate(&f->mca);
+	KUNIT_EXPECT_TRUE(test, f->mca.mipps_dfp_attempted);
+	KUNIT_EXPECT_FALSE(test, xiaomi_mca_authenticated(&f->mca));
+	KUNIT_EXPECT_EQ(test, f->data_role, MCA_DATA_ROLE_UFP);
+	KUNIT_EXPECT_EQ(test, f->verify, 0);
+	KUNIT_EXPECT_EQ(test, f->vdm_count, 1);
+
+	/* The new policy can retry MiPPS without detaching the cable. */
+	f->mca.mipps_attempted = false;
+	xiaomi_mca_mipps_authenticate(&f->mca);
+	KUNIT_EXPECT_EQ(test, f->data_role, MCA_DATA_ROLE_UFP);
+	KUNIT_EXPECT_EQ(test, f->vdm_count, 1);
+}
+
 static void xiaomi_mca_test_mipps_bad_digest(struct kunit *test)
 {
 	struct mca_policy_fixture *f = mca_auth_fixture(test);
@@ -5972,6 +6028,8 @@ static struct kunit_case xiaomi_mca_test_cases[] = {
