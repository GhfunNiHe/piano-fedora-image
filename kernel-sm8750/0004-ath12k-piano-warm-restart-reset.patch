 	return ret;
 }
@@ -1734,11 +1736,30 @@ static void ath12k_core_restart(struct work_struct *work)
 	complete(&ab->restart_completed);
 }
 
+static void ath12k_core_reset_fail(struct ath12k_base *ab)
+{
+	int fail_count;
+
+	complete(&ab->restart_completed);
+
+	fail_count = atomic_inc_return(&ab->fail_cont_count);
+	if (fail_count >= ATH12K_RESET_MAX_FAIL_COUNT_FIRST)
+		ab->reset_fail_timeout = jiffies + ATH12K_RESET_FAIL_TIMEOUT_HZ;
+
+	if (atomic_dec_if_positive(&ab->reset_count) < 0) {
+		WARN_ON_ONCE(ab->is_reset);
+		return;
+	}
+
+	complete(&ab->reset_complete);
+	ab->is_reset = false;
+}
+
 static void ath12k_core_reset(struct work_struct *work)
 {
 	struct ath12k_base *ab = container_of(work, struct ath12k_base, reset_work);
 	struct ath12k_hw_group *ag = ab->ag;
-	int reset_count, fail_cont_count, i;
+	int reset_count, fail_cont_count, i, ret;
 	long time_left;
 
 	/* The new MHI devices are probed only after the system resume */
@@ -1824,7 +1845,14 @@ static void ath12k_core_reset(struct work_struct *work)
 		if (!ab)
 			continue;
 
-		ath12k_hif_power_up(ab);
+		ret = ath12k_hif_power_up(ab);
+		if (ret) {
+			ath12k_warn(ab, "failed to power up during recovery: %d\n",
+				    ret);
+			ath12k_core_reset_fail(ab);
+			continue;
+		}
+
 		ath12k_dbg(ab, ATH12K_DBG_BOOT, "reset started\n");
 	}
 
