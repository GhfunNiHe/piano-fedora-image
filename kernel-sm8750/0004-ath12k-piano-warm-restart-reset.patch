+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -226,8 +226,10 @@ int ath12k_core_resume_early(struct ath12k_base *ab)
 	reinit_completion(&ab->restart_completed);
 	WRITE_ONCE(ab->resuming, true);
