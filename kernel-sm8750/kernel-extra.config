# Config differences from the v1.3.1 compiled kernel package.
# ThinLTO, built-in Windows NT synchronization and built-in F2FS.
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set
CONFIG_NTSYNC=y
CONFIG_F2FS_FS=y

# Missing from the v1.3.1 compiled kernel config.
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_SCSI_UFS_BSG=y
